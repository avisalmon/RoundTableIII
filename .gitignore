# Local agent/editor state
state/
tools/
collected_mail/

# Draft outreach letters to contributors, generated by tools/build_contributor_emails.py.
# They quote unpublished manuscript text and contain personal email addresses.
outreach/

# Generated book drafts, outlines, meeting notes, and progress trackers
book/*
!book/manuscript.md
!book/references.md
!book/pages/
!book/pages/*.md
# Round Table source materials are published with the site so that a reader can open
# what a citation points at. The steering-team summaries are the exception: internal
# working documents in Hebrew, recording the group's own assessment of its meetings.
# They are named in the book and in references.md but never distributed.
# build_book.py enforces this split and fails the build if a withheld file is tracked.
materials/steering-*

# Downloaded rendering assets (Paged.js, Mermaid, fonts) and the print build's
# intermediate HTML. Both are regenerated by build_book.py.
assets/
book-print.html
cover-print.html
short-print.html
preview-*.png

# Python bytecode
__pycache__/
*.pyc

# Common local/transient files
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.log